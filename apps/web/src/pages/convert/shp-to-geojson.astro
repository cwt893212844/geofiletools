---
import ConverterPage from '../../layouts/ConverterPage.astro';
---

<ConverterPage
  title="Shapefile to GeoJSON Converter"
  description="Convert ESRI Shapefile to GeoJSON online. Upload .shp with sidecar files or a zipped shapefile."
  mode="shp-to-geojson"
  accept=".shp,.shx,.dbf,.prj,.cpg,.zip"
  hint="Select .shp + .shx + .dbf (and optionally .prj), or a .zip containing all files"
  faq={[
    {
      question: 'Which files do I need to upload?',
      answer: 'A Shapefile requires at least 3 files: .shp (geometry), .shx (index), and .dbf (attributes). Optionally include .prj (coordinate system) and .cpg (encoding). You can also upload a .zip containing all of them.',
    },
    {
      question: 'Can I upload just the .shp file?',
      answer: 'No. A .shp file alone is not enough — it needs the companion .shx and .dbf files to work. Select all sidecar files together, or zip them first.',
    },
    {
      question: 'Is there a file size limit?',
      answer: 'Browser processing is limited to 30 MB per upload for stable performance.',
    },
  ]}
/>
